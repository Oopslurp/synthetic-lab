---
// Decorative choreography, not a live collaboration session.
---
<div class="design-canvas" aria-hidden="true">
  <div class="canvas-grid"></div>
  <canvas></canvas>
  <span class="canvas-caption">SL / ATELIER NUMÉRIQUE</span>
  <span class="canvas-coordinate">01 — COMPOSITION</span>
</div>
<div class="canvas-dock" hidden role="group" aria-label="Animation de l’accueil">
  <span class="canvas-avatars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="canvas-status">Composition</span>
  <span class="canvas-divider" aria-hidden="true"></span>
  <button type="button" class="canvas-toggle" aria-label="Mettre l’animation en pause" title="Mettre l’animation en pause">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path class="pause-icon" d="M7 5v10M13 5v10"/><path class="play-icon" d="m7 4 8 6-8 6Z"/></svg>
  </button>
  <button type="button" class="canvas-replay" aria-label="Rejouer l’animation" title="Rejouer l’animation">
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M4 8a6 6 0 1 1 0 5M4 3v5h5"/></svg>
  </button>
  <span class="canvas-progress" aria-hidden="true"></span>
</div>

<style>
  .design-canvas { position: absolute; inset: 0; z-index: 4; pointer-events: none; overflow: hidden; opacity: var(--canvas-visibility, 0); }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .canvas-grid { position: absolute; inset: 0; background-image: radial-gradient(var(--accent) .65px, transparent .65px); background-size: 24px 24px; opacity: calc(var(--canvas-energy, 0) * .14); mask-image: linear-gradient(transparent, #000 18%, #000 75%, transparent); }
  .canvas-caption, .canvas-coordinate { position: absolute; top: 22px; color: var(--muted); font: 9px var(--font-mono); letter-spacing: .13em; opacity: calc(var(--canvas-energy, 0) * .7); }
  .canvas-caption { left: 24px; } .canvas-coordinate { right: 24px; }
  .canvas-dock { position: relative; display: flex; align-items: center; gap: 12px; padding: 5px 7px 5px 16px; border: 1px solid var(--line); border-radius: 50px; background: var(--bg); box-shadow: 0 4px 20px #00000008; color: var(--muted); font: 10px var(--font-mono); white-space: nowrap; overflow: hidden; }
  .canvas-dock[hidden] { display: none; }
  .canvas-avatars { display: flex; padding-left: 3px; }
  .canvas-avatars i { width: 10px; height: 10px; border-radius: 50%; background: #5c86ff; margin-left: -3px; border: 2px solid var(--bg); box-sizing: content-box; }
  .canvas-avatars i:nth-child(2) { background: #dc995e; }
  .canvas-avatars i:nth-child(3) { background: #61af96; }
  .canvas-avatars i:nth-child(4) { background: #b497e5; }
  .canvas-status { min-width: 11ch; }
  .canvas-divider { height: 14px; width: 1px; background: var(--line); }
  button { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; transition: color .2s, background .2s; }
  button:hover { color: var(--accent); background: var(--accent-soft); }
  svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .play-icon { display: none; }
  .canvas-dock[data-paused='true'] .pause-icon { display: none; }
  .canvas-dock[data-paused='true'] .play-icon { display: block; }
  .canvas-progress { position: absolute; bottom: 0; left: 0; height: 2px; width: 100%; background: var(--accent); transform: scaleX(var(--canvas-progress, 0)); transform-origin: left; opacity: .5; }
  @media (max-width: 600px) {
    .canvas-caption, .canvas-coordinate { display: none; }
    .canvas-dock { gap: 8px; }
    button { width: 36px; height: 36px; }
  }
  @media (prefers-reduced-motion: reduce) { .design-canvas, .canvas-dock { display: none !important; } }
</style>

<script>
  import { initDesignCanvas } from '../scripts/design-canvas';
  const stage = document.querySelector<HTMLElement>('[data-design-stage]');
  if (stage) initDesignCanvas(stage);
</script>
