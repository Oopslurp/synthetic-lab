---
import Base from '../layouts/Base.astro';
import ParticleLogo from '../components/ParticleLogo.astro';
import ConsoleVibe from '../components/ConsoleVibe.astro';

const etapes = [
  {
    titre: 'Poser mes idées',
    texte: `Je commence avec un stylo et des feuilles. Je note les idées que
    j'ai en tête et ce que j'aimerais obtenir. Ensuite, j'en discute avec
    l'IA pour définir le cadre du projet et voir ce qui semble faisable ou
    risque de le compliquer. Je lui demande un plan avec des étapes pour
    construire le projet petit à petit.`,
  },
  {
    titre: 'Essayer au fur et à mesure',
    texte: `Pendant le développement, je vérifie régulièrement ce qui a été
    produit. J'essaie les fonctions, je regarde si l'interface correspond à
    mon idée et je note ce qui pose problème. Pour les projets scientifiques,
    je compare aussi les résultats avec le cours ou des calculs à la main.`,
  },
  {
    titre: 'Reprendre ce qui bloque',
    texte: `Quand quelque chose ne marche pas, je cherche à préciser le
    problème : ce que j'ai fait, ce qui s'est passé et ce que j'attendais.
    Je transmets ces éléments à l'IA, avec le message d'erreur s'il y en a un.
    Ensuite, j'essaie la correction pour voir si le problème est bien réglé.`,
  },
  {
    titre: 'Vérifier les réponses',
    texte: `Je fais des recherches en parallèle pour guider l'IA et vérifier
    ses propositions. Selon le projet, je m'appuie sur mes cours, la
    documentation des outils ou des essais concrets. Il m'arrive aussi de
    demander une relecture à une autre IA. Sur chaque fiche, j'explique
    ce que l'IA a produit, ce que j'ai fait et comment je l'ai vérifié.`,
  },
];

const outils = [
  'Claude',
  'ChatGPT',
  'Codex',
  'VS Code',
  'GitHub',
  'JavaScript / TypeScript',
  'React',
  'Tailwind CSS',
  'Python',
  'Rust',
  'GSAP',
  'IA locales (Llama · Mistral · Qwen)',
];
---

<Base
  title="Méthode — Synthetic Lab"
  description="Comment je travaille : démarrage d'un projet, tests, débogage et vérification systématique des réponses de l'IA."
>
  <section class="container">
    <header class="entete">
      <p class="mono-label" data-reveal>Méthode de travail</p>
      <h1 data-split>Comment je travaille<span class="dot">.</span></h1>
      <p class="lead" data-split="0.25">
        Je commence par un brouillon, puis j'avance avec l'aide de l'IA.
        Entre les deux, il y a beaucoup d'essais, de recherches et de
        corrections. Voici comment je m'y prends.
      </p>
      <ConsoleVibe scene="methode" />
    </header>

    <div class="etapes-layout">
      <div class="etapes">
        {
          etapes.map((e, i) => (
            <section class="etape" data-reveal>
              <span class="numero mono-label">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2>{e.titre}</h2>
                <p>{e.texte}</p>
              </div>
            </section>
          ))
        }
      </div>
      <aside class="mascotte">
        <ParticleLogo
          forme="claude"
          legende="Claude Code · compagnon de travail — survoler ↑"
        />
      </aside>
    </div>

    <section class="outils" data-reveal>
      <p class="mono-label">Outils du quotidien</p>
      <div class="chips">
        {outils.map((o) => <span class="chip">{o}</span>)}
      </div>
    </section>

    <blockquote class="credo">
      <p data-split>
        «&nbsp;Je pose mes idées sur le papier, puis je les construis avec
        l'IA. Au fur et à mesure, je teste et je reprends ce qui ne me
        convient pas.&nbsp;»
      </p>
    </blockquote>
  </section>
</Base>

<style>
  .entete {
    position: relative;
    padding: clamp(3rem, 8vh, 5.5rem) 0 clamp(2rem, 5vh, 3.5rem);
  }
  .entete h1 {
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin: 0.9rem 0 1.3rem;
  }
  .dot { color: var(--accent); }
  .lead {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--muted);
    max-width: 38em;
    line-height: 1.55;
    text-wrap: balance;
  }

  .etapes-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .mascotte {
    position: sticky;
    top: clamp(6rem, 22vh, 11rem);
    padding-top: 2.5rem;
  }
  .etapes { display: grid; }
  .etape {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    padding: clamp(2rem, 4.5vh, 3rem) 0;
    border-top: 1px solid var(--line);
  }
  .etape .numero { color: var(--accent); padding-top: 0.55rem; }
  .etape h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    margin-bottom: 0.9rem;
  }
  .etape p {
    max-width: 62ch;
    line-height: 1.7;
  }

  .outils {
    padding: clamp(2rem, 4.5vh, 3rem) 0;
    border-top: 1px solid var(--line);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .credo {
    margin: clamp(3rem, 8vh, 5.5rem) 0 0;
    padding: 0;
    border: none;
  }
  .credo p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    max-width: 26em;
    text-wrap: balance;
  }

  @media (max-width: 860px) {
    .etapes-layout { grid-template-columns: 1fr; }
    .mascotte { position: static; padding-top: 1rem; }
  }
  @media (max-width: 600px) {
    .etape { grid-template-columns: 1fr; gap: 0.6rem; }
    .etape .numero { padding-top: 0; }
  }
</style>
