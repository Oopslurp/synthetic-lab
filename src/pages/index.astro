---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ParticleLogo from '../components/ParticleLogo.astro';
import ConsoleVibe from '../components/ConsoleVibe.astro';
import CoupDeCoeur from '../components/CoupDeCoeur.astro';
import DesignCanvas from '../components/DesignCanvas.astro';
import ReadingCanvas from '../components/ReadingCanvas.astro';
import { url } from '../lib/paths';

const projets = (
  await getCollection('projets', ({ data }) => !data.brouillon)
).sort((a, b) => a.data.ordre - b.data.ordre);

const termines = projets.filter((p) => p.data.statut === 'termine').length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Synthetic Lab — Mathieu Chow"
  description="Carnet de projets de Mathieu Chow : simulations scientifiques, jeux, outils d'apprentissage et expérimentations web réalisés avec l'aide de l'intelligence artificielle."
>
  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero-stage" data-design-stage aria-label="Bienvenue dans Synthetic Lab">
  <div class="hero container">
    <p class="mono-label hero-eyebrow" data-reveal><span class="atelier-dot" aria-hidden="true"></span> Mathieu Chow — Carnet de projets</p>
    <h1 data-split data-canvas-target="01 / Identité">Synthetic Lab<span class="dot">.</span></h1>
    <div class="hero-workspace">
    <div class="hero-description">
    <p class="lead" data-split="0.3" data-canvas-target="02 / Intentions">
      Simulations, jeux, outils d'apprentissage et expérimentations web,
      réalisés avec l'aide de l'intelligence artificielle.
    </p>
    <div class="hero-meta" data-reveal="0.55" data-canvas-target="03 / Repères">
      <span class="chip">Terminale · maths & physique-chimie</span>
      <span class="chip">Projets personnels</span>
      <span class="chip chip--accent">{pad(projets.length)} projets · {pad(termines)} terminé</span>
    </div>
    </div>
    <div class="hero-terminal" data-canvas-target="04 / Expérimentations">
      <ConsoleVibe scene="accueil" />
    </div>
    </div>
    <div class="hero-bottom">
      <a class="explore-link" href={url('/#projets')}><span class="explore-arrow" aria-hidden="true">↓</span> Explorer les projets <span class="explore-count">/{pad(projets.length)}</span></a>
      <DesignCanvas />
      <span class="hero-note">Une idée. Du code. Du concret.</span>
    </div>
  </div>
  </section>

  <!-- ── Positionnement ───────────────────────────────────────── -->
  <section class="intro container" data-reveal>
    <hr class="rule" />
    <p>
      Je développe ces projets pour <strong>apprendre en réalisant</strong> :
      approfondir les sciences par la création, et mobiliser l'IA comme un
      outil au service du raisonnement, du prototypage et de
      l'expérimentation. Chaque fiche documente ce que l'IA a généré, ce que
      j'ai fait moi-même — et comment je l'ai vérifié.
    </p>
  </section>

  <!-- ── Projets ──────────────────────────────────────────────── -->
  <section id="projets" class="projets container">
    <div class="section-head" data-reveal>
      <h2>Projets <span class="count">({pad(projets.length)})</span></h2>
      <div class="section-meta">
        <p class="mono-label">Numériques, scientifiques & créatifs</p>
        <p class="mono-label legende">
          <CoupDeCoeur taille={1.45} /> Coup de cœur
        </p>
      </div>
    </div>
    <div class="rows">
      {
        projets.map((p, i) => (
          <ProjectRow
            numero={pad(i + 1)}
            slug={p.id}
            titre={p.data.titre}
            categorie={p.data.categorie}
            periode={p.data.periode}
            statut={p.data.statut}
            coupDeCoeur={p.data.coup_de_coeur}
          />
        ))
      }
    </div>
  </section>

  <!-- ── Démarche ─────────────────────────────────────────────── -->
  <section class="demarche container">
    <div class="demarche-grille">
      <div class="demarche-texte">
        <p class="mono-label" data-reveal>Démarche</p>
        <h2 data-split>L'IA est un outil,<br />pas un substitut au travail.</h2>
        <p data-reveal>
          Brouillon papier, plan critiqué, code testé, résultats vérifiés contre
          le cours ou à la main : ma façon de travailler est documentée,
          étape par étape, sur une page dédiée.
        </p>
        <a class="btn" href={url('/methode/')} data-reveal>Lire ma méthode&nbsp;→</a>
      </div>
      <ParticleLogo />
    </div>
  </section>
  <ReadingCanvas />
</Base>

<style>
  .hero-stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-bottom: 1px solid var(--line);
  }
  .hero {
    padding: clamp(3.5rem, 8vh, 6rem) 0 1.8rem;
  }
  .hero-eyebrow { display: flex; align-items: center; gap: .7rem; }
  .atelier-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; }
  .hero h1 {
    width: fit-content;
    max-width: 100%;
    font-size: clamp(3.4rem, 11.4vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    margin: 1.6rem 0 2.5rem;
  }
  .hero .dot { color: var(--accent); }
  .hero-workspace { display: grid; grid-template-columns: 1.2fr .85fr; gap: clamp(3rem, 7vw, 7rem); align-items: start; }
  .hero-description { padding-top: .5rem; min-width: 0; }
  .hero-terminal { min-width: 0; }
  .hero-terminal :global(.console-zone) { position: static; width: 100%; max-width: none; margin: 0; display: block; }
  .hero-terminal :global(.console-vibe) { width: 100%; min-height: 230px; border-radius: 5px; }
  .hero-terminal :global(.flux) { min-height: 10.5em; }
  .hero-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: clamp(2.5rem, 6vh, 4rem); padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .explore-link { display: inline-flex; align-items: center; gap: .8rem; font: 11px var(--font-mono); text-decoration: none; white-space: nowrap; }
  .explore-arrow { display: grid; place-items: center; border: 1px solid var(--line); border-radius: 50%; width: 34px; height: 34px; font-size: 19px; transition: transform .3s var(--ease), border-color .3s; }
  .explore-link:hover .explore-arrow { transform: translateY(3px); border-color: var(--accent); }
  .explore-count { color: var(--accent); }
  .hero-note { font: 9px var(--font-mono); color: var(--muted); }
  @media (max-width: 1000px) { .hero-note { display: none; } }
  @media (max-width: 760px) {
    .hero { padding-top: 3.5rem; }
    .hero-workspace { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero h1 { font-size: clamp(3.2rem, 11.4vw, 5.4rem); margin-bottom: 2.5rem; }
    .hero-terminal { max-width: 32rem; }
    .hero-bottom { margin-top: 2.5rem; flex-wrap: wrap; gap: 1.3rem; }
    .hero-eyebrow { font-size: .58rem; letter-spacing: .08em; }
  }
  .lead {
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.5;
    color: var(--muted);
    max-width: 34em;
    text-wrap: balance;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.2rem;
  }

  .intro { padding: clamp(1.5rem, 4vh, 3rem) 0; }
  .intro p {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.65;
    max-width: 44em;
    padding-top: clamp(1.8rem, 4vh, 2.8rem);
  }

  .projets { padding-top: clamp(3rem, 8vh, 5.5rem); }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.6rem;
  }
  .section-head h2 {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.5em;
    font-weight: 500;
    color: var(--accent);
    vertical-align: super;
  }
  .section-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }
  .legende {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .section-meta { align-items: flex-start; }
  }

  .demarche { padding-top: clamp(5rem, 12vh, 8rem); }
  .demarche-grille {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .demarche-texte {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.4rem;
  }
  .demarche-texte h2 {
    font-size: clamp(2rem, 5.5vw, 3.8rem);
    letter-spacing: -0.03em;
  }
  .demarche-texte p {
    color: var(--muted);
    max-width: 42em;
    font-size: 1.05rem;
  }

  @media (max-width: 780px) {
    .demarche-grille { grid-template-columns: 1fr; }
  }
</style>

<style is:global>
  /* The existing margin code remains part of the entrance, then recedes. */
  html:has([data-design-stage]) .pluie { opacity: var(--atelier-ambient, 1); transition: opacity .2s; }
</style>
